  "items": [
    { "text": "Αν βρέχει, πάρε ομπρέλα", "category": "an_tote" },
    { "text": "Αν φανάρι, περίμενε, αλλιώς κοίτα", "category": "an_allios" },
    { "text": "Επανάλαβε ώσπου να μην υπάρχουν κάρτες", "category": "osos" },
    { "text": "Αν ανήκει στην Υπατία, δώσε της, αλλιώς δώσε στον Ήρωνα", "category": "an_allios" },
    { "text": "Αν δεν ανάβει, επιδιόρθωσέ το", "category": "an_tote" },
    { "text": "Επανάλαβε ώσπου η στοίβα να είναι άδεια", "category": "osos" },
    { "text": "Αν ναι, τρέξε, αλλιώς περπάτα", "category": "an_allios" },
    { "text": "Αν χιονίζει, φόρεσε μπουφάν", "category": "an_tote" },
