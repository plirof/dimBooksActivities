<?php
session_start();

if (!isset($_SESSION['username']) || $_SESSION['role'] !== 'admin') {
    header('Location: ../index.php');
    exit;
}

require_once '../api/file_utils.php';

// Check if editing existing activity
$isEditing = isset($_GET['id']);
$editingActivity = null;

if ($isEditing) {
    $activityId = $_GET['id'];
    $activities = readJSONFile('../admin/activities/activities.json');
    
    if ($activities !== null && isset($activities[$activityId])) {
        $editingActivity = $activities[$activityId];
    } else {
        // Activity not found, redirect to dashboard
        header('Location: dashboard.php');
        exit;
    }
}
?>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title><?php echo $isEditing ? 'Edit Missing Word Activity - Wordwall' : 'Create Missing Word Activity - Wordwall'; ?></title>
    <link rel="stylesheet" href="../css/style.css">
    <style>
        .sentence-form {
            background: #f9f9f9;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid #667eea;
        }
        
        .sentence-form h3 {
            margin-top: 0;
            color: #667eea;
        }
        
        .options-inputs {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        
        .option-input label {
            font-size: 12px;
            margin-bottom: 2px;
        }
        
        .correct-radio {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 10px;
            background: white;
            padding: 10px;
            border-radius: 5px;
        }
        
        .correct-radio input[type="radio"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
        
        .remove-btn {
            background: #dc3545;
            padding: 5px 15px;
            font-size: 14px;
            margin-top: 10px;
        }
        
        .remove-btn:hover {
            background: #c82333;
        }
        
        .add-sentence-btn {
            background: #28a745;
            margin-bottom: 20px;
        }
        
        .add-sentence-btn:hover {
            background: #218838;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><?php echo $isEditing ? 'Edit Missing Word Activity' : 'Create Missing Word Activity'; ?></h1>
            <div class="header-actions">
                <a href="create_activity.php" class="button">Back to Activity Types</a>
                <a href="dashboard.php" class="button">Back to Dashboard</a>
            </div>
        </div>
        
        <form id="missingwordForm">
            <div class="form-section">
                <h2>Activity Details</h2>
                
                <div class="form-group">
                    <label for="title">Title:</label>
                    <input type="text" id="title" name="title" required <?php echo $isEditing ? 'value="' . htmlspecialchars($editingActivity['title']) . '"' : ''; ?>>
                </div>
            </div>
            
            <h2>Sentences</h2>
            <p>Use ___ to mark where the missing word should be.</p>
            <div id="sentencesContainer"></div>
            
            <button type="button" class="add-sentence-btn" onclick="addSentence()">Add Sentence</button>
            
            <div class="form-section">
                <button type="submit">Save Activity</button>
            </div>
        </form>
    </div>
    
    <script>
        var sentenceCount = 0;
        
        var isEditing = <?php echo $isEditing ? 'true' : 'false'; ?>;
        var editingId = '<?php echo $isEditing ? htmlspecialchars($editingActivity['id']) : ''; ?>';
        var editingData = <?php echo $isEditing ? json_encode($editingActivity['data']) : '{}'; ?>;
        
        function addSentence(sentenceData) {
            sentenceCount++;
            
            var container = document.getElementById('sentencesContainer');
            var sentenceDiv = document.createElement('div');
            sentenceDiv.className = 'sentence-form';
            sentenceDiv.id = 'sentence_' + sentenceCount;
            
            var sentenceValue = sentenceData ? sentenceData.sentence : '';
            var optionsValue = sentenceData ? sentenceData.options : ['', '', '', ''];
            var correctValue = sentenceData ? sentenceData.correct : '';
            var correctIndex = optionsValue.indexOf(correctValue);
            
            sentenceDiv.innerHTML = 
                '<h3>Sentence ' + sentenceCount + '</h3>' +
                '<div class="form-group">' +
                    '<label>Sentence with missing word (use ___ for blank):</label>' +
                    '<input type="text" class="sentence-text" required placeholder="e.g., The sky is ___ today." value="' + sentenceValue + '">' +
                '</div>' +
                '<h4>Options (4 options, select correct answer):</h4>' +
                '<div class="options-inputs">' +
                    '<div class="option-input">' +
                        '<label>Option 1:</label>' +
                        '<input type="text" class="option-text" required value="' + optionsValue[0] + '">' +
                        '<div class="correct-radio">' +
                            '<input type="radio" name="correct_' + sentenceCount + '" value="0" required' + (correctIndex === 0 ? ' checked' : '') + '>' +
                            '<span>Correct</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="option-input">' +
                        '<label>Option 2:</label>' +
                        '<input type="text" class="option-text" required value="' + optionsValue[1] + '">' +
                        '<div class="correct-radio">' +
                            '<input type="radio" name="correct_' + sentenceCount + '" value="1"' + (correctIndex === 1 ? ' checked' : '') + '>' +
                            '<span>Correct</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="option-input">' +
                        '<label>Option 3:</label>' +
                        '<input type="text" class="option-text" required value="' + optionsValue[2] + '">' +
                        '<div class="correct-radio">' +
                            '<input type="radio" name="correct_' + sentenceCount + '" value="2"' + (correctIndex === 2 ? ' checked' : '') + '>' +
                            '<span>Correct</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="option-input">' +
                        '<label>Option 4:</label>' +
                        '<input type="text" class="option-text" required value="' + optionsValue[3] + '">' +
                        '<div class="correct-radio">' +
                            '<input type="radio" name="correct_' + sentenceCount + '" value="3"' + (correctIndex === 3 ? ' checked' : '') + '>' +
                            '<span>Correct</span>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<button type="button" class="remove-btn" onclick="removeSentence(' + sentenceCount + ')">Remove Sentence</button>';
            
            container.appendChild(sentenceDiv);
        }
        
        function removeSentence(id) {
            var sentenceDiv = document.getElementById('sentence_' + id);
            if (sentenceDiv) {
                sentenceDiv.parentNode.removeChild(sentenceDiv);
            }
        }
        
        document.getElementById('missingwordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            var title = document.getElementById('title').value;
            var sentenceForms = document.querySelectorAll('.sentence-form');
            
            if (sentenceForms.length === 0) {
                alert('Please add at least one sentence.');
                return;
            }
            
            var sentences = [];
            
            for (var i = 0; i < sentenceForms.length; i++) {
                var form = sentenceForms[i];
                var sentenceText = form.querySelector('.sentence-text').value;
                var optionInputs = form.querySelectorAll('.option-text');
                var correctRadio = form.querySelector('input[type="radio"]:checked');
                
                if (!correctRadio) {
                    alert('Please select a correct answer for Sentence ' + (i + 1));
                    return;
                }
                
                var options = [];
                for (var j = 0; j < optionInputs.length; j++) {
                    options.push(optionInputs[j].value);
                }
                
                sentences.push({
                    sentence: sentenceText,
                    options: options,
                    correct: options[parseInt(correctRadio.value)]
                });
            }
            
            var activityData = {
                title: title,
                type: 'missingword',
                created_by: 'admin',
                created_date: new Date().toISOString().split('T')[0],
                data: {
                    sentences: sentences
                }
            };
            
            // Include ID if editing
            if (isEditing) {
                activityData.id = editingId;
            }
            
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '../api/save_activity.php', true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            
            xhr.onload = function() {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        alert('Activity saved successfully!');
                        window.location.href = 'dashboard.php';
                    } else {
                        alert('Error saving activity: ' + response.message);
                    }
                } else {
                    alert('Error saving activity.');
                }
            };
            
            xhr.send(JSON.stringify(activityData));
        });
        
        // Initialize page
        function initPage() {
            var urlParams = new URLSearchParams(window.location.search);
            var templateId = urlParams.get('template');
            
            if (templateId) {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', 'templates/missingword/templates.json', true);
                
                xhr.onload = function() {
                    if (xhr.status === 200) {
                        try {
                            var data = JSON.parse(xhr.responseText);
                            var template = null;
                            for (var i = 0; i < data.templates.length; i++) {
                                if (data.templates[i].id === templateId) {
                                    template = data.templates[i];
                                    break;
                                }
                            }
                            
                            if (template && template.items) {
                                document.getElementById('title').value = template.name;
                                for (var j = 0; j < template.items.length; j++) {
                                    var item = template.items[j];
                                    addSentence({
                                        sentence: item.text,
                                        options: item.options || ['', '', '', ''],
                                        correct: item.answer
                                    });
                                }
                                alert('Template "' + template.name + '" loaded! You can customize it before saving.');
                            }
                        } catch (e) {
                            console.error('Error loading template:', e);
                            addSentence();
                        }
                    } else {
                        addSentence();
                    }
                };
                
                xhr.onerror = function() {
                    addSentence();
                };
                
                xhr.send();
            } else if (isEditing && editingData.sentences) {
                for (var i = 0; i < editingData.sentences.length; i++) {
                    addSentence(editingData.sentences[i]);
                }
            } else {
                addSentence();
            }
        }
        
        initPage();
    </script>
</body>
</html>
